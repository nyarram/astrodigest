# Postgres (Neon)
NEON_DATABASE_URL=

# Redis — self-hosted container on the VPS (see docker-compose.yml).
# Used by BullMQ (apps/api, packages/workers, packages/digest-assembly) and
# by the API's digest response cache.
# On the VPS: redis://redis:6379 (docker-compose service DNS name)
REDIS_URL=

# AI
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# External APIs
NASA_API_KEY=

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Observability
SENTRY_DSN=
LOGTAIL_SOURCE_TOKEN=

# Runtime
PORT=
NODE_ENV=

# Optional: override the workers' raw_content poll interval (ms).
# Defaults to 3600000 (hourly). Keep it long in production — a short interval
# keeps Neon's compute from autosuspending and burns the Free-plan quota.
# Lower it only for local development.
RAW_CONTENT_POLL_INTERVAL_MS=
